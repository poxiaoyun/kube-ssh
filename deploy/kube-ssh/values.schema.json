{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "kubeSsh": {
      "type": "object",
      "title": "SSH gateway",
      "properties": {
        "advertiseAddresses": {
          "type": "array",
          "title": "Advertise addresses",
          "description": "Optional externally reachable host:port addresses published to Access status. Multiple addresses are supported. When omitted, a NodePort Service publishes {NodeIP}:<nodePort> automatically.",
          "examples": [
            [
              "ssh.example.com:2222"
            ]
          ],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(\\{NodeIP\\}|\\[[0-9A-Fa-f:.]+\\]|[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*):([1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
          }
        },
        "managed": {
          "type": "object",
          "title": "Pod SSH",
          "properties": {
            "transport": {
              "type": "string",
              "title": "Pod SSH transport",
              "description": "Selects how Pod SSH operations reach target containers. CRI uses automatic runtime discovery and Chart-managed mTLS by default; no additional configuration is needed for standard runtime socket paths.",
              "enum": [
                "apiserver",
                "cri"
              ],
              "x-enum": [
                {
                  "name": "API Server",
                  "description": "Uses pods/exec and pods/portforward through the Kubernetes API server. This is the default and requires no node component.",
                  "value": "apiserver"
                },
                {
                  "name": "CRI",
                  "description": "Sends streams over mTLS to kube-ssh-node on the target node, then uses CRI. High-volume data bypasses the API server and never falls back to the API Server transport.",
                  "value": "cri"
                }
              ],
              "default": "apiserver"
            }
          }
        },
        "service": {
          "type": "object",
          "title": "Service",
          "allOf": [
            {
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Service type",
                  "enum": [
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ]
                }
              },
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "NodePort",
                      "LoadBalancer"
                    ]
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "properties": {
                  "nodePorts": {
                    "type": "object",
                    "properties": {
                      "ssh": {
                        "type": "integer",
                        "title": "SSH node port",
                        "default": 30022,
                        "minimum": 30000,
                        "maximum": 32767
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
